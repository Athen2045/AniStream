{
  "name": "anistream",
  "version": "0.1.3",
  "private": true,
  "description": "Personal anime and manga discovery, playback, reading, and tracker sync for macOS and Windows",
  "author": "Athen2045",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "check:packaged-preload": "node scripts/verify-packaged-preload.mjs",
    "check:win-installer": "node scripts/verify-windows-installer.mjs",
    "check:anilist-oauth": "node scripts/verify-anilist-oauth.mjs",
    "check:product-slice": "node scripts/verify-product-slice.mjs",
    "check:release-version": "node scripts/verify-release-version.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
