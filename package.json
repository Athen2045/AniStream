{
  "name": "anistream",
  "version": "2.1.0",
  "private": true,
  "description": "Personal anime, manga, movie, and show discovery with local playback progress for macOS and Windows",
  "author": "Athen2045",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "check:packaged-preload": "node scripts/verify-packaged-preload.mjs",
    "check:packaged-build": "node scripts/verify-packaged-build.mjs",
    "check:branding": "node scripts/verify-branding-assets.mjs",
    "check:mac-package": "node scripts/verify-mac-package.mjs",
    "check:win-installer": "node scripts/verify-windows-installer.mjs",
    "check:anilist-oauth": "node scripts/verify-anilist-oauth.mjs",
    "check:product-slice": "node scripts/verify-product-slice.mjs",
    "check:release-version": "node scripts/verify-release-version.mjs",
    "build:website": "node scripts/build-website.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "npm run build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "package:mac": "npm run build && node scripts/write-app-keys.mjs && electron-builder --mac --arm64 --publish never",
    "package:win": "npm run build && node scripts/write-app-keys.mjs && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "@videojs/react": "10.1.0",
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "hls.js": "1.7.3",
    "jassub": "2.5.23"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^12.43.0",
    "globals": "^17.13.0",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
