{
  "version": 2,
  "anime": {
    "database": [
      {
        "id": "anilist"
      },
      {
        "id": "mal"
      },
      {
        "id": "kitsu"
      },
      {
        "id": "anizip"
      }
    ],
    "media": [
      {
        "id": "anilist-player",
        "kind": "anilist-embed",
        "episodeUrl": "https://anilist-player.example/e/{aniListId}/{episode}?lang={audio}&autoplay=1",
        "startAtParam": "t",
        "eventSource": "example_player",
        "scriptHosts": [],
        "blockedRequestHosts": ["ads.example"],
        "stubGlobals": ["adlib"]
      },
      {
        "id": "anime-player",
        "kind": "indexed-embed",
        "recentIndexUrl": "https://episode-index.example/recent?limit=100",
        "seriesUrl": "https://episode-index.example/series/{seriesId}",
        "episodeEmbedUrl": "https://anime-player.example/embed/{embedId}/{audio}",
        "aniListEmbedUrl": "https://anime-player.example/anilist/{aniListId}/{episode}/{audio}",
        "scriptHosts": ["libs.example"],
        "blockedRequestHosts": ["analytics.example"]
      }
    ]
  },
  "manga": {
    "database": [
      {
        "id": "anilist"
      },
      {
        "id": "mangadex"
      },
      {
        "id": "mangabaka"
      },
      {
        "id": "mangaupdates"
      },
      {
        "id": "mal"
      }
    ],
    "media": [
      {
        "id": "mangadex",
        "kind": "mangadex"
      },
      {
        "id": "chapter-mirror",
        "kind": "chapter-mirror",
        "enabled": false,
        "label": "Chapter mirror",
        "mappingSite": "ExampleSite",
        "chapterListUrl": "https://chapter-mirror.example/series/{seriesId}/chapters",
        "chapterPagesUrl": "https://chapter-mirror.example/chapters/{chapterId}/pages",
        "imageHosts": ["images.chapter-mirror.example"]
      }
    ]
  },
  "more": {
    "database": [
      {
        "id": "tmdb"
      }
    ],
    "media": [
      {
        "id": "more-player",
        "kind": "tmdb-embed",
        "movieUrl": "https://more-player.example/movie/{tmdbId}",
        "tvUrl": "https://more-player.example/tv/{tmdbId}/{season}/{episode}",
        "startAtParam": "start",
        "stripElectronUserAgent": false,
        "sandboxed": true,
        "scriptHosts": ["libs.example"],
        "blockedScriptPaths": ["/lib/ad.js"]
      },
      {
        "id": "prefixed-player",
        "kind": "tmdb-embed",
        "movieUrl": "https://prefixed-player.example/embed/movie/{tmdbId}",
        "tvUrl": "https://prefixed-player.example/embed/tv/{tmdbId}?s={season}&e={episode}",
        "startAtParam": "t",
        "eventPrefix": "player:",
        "startTimeoutSeconds": 45,
        "stripElectronUserAgent": false,
        "scriptHosts": [],
        "blockedScriptPaths": ["/ads.js"],
        "blockedRequestHosts": ["analytics.example"]
      },
      {
        "id": "redirecting-player",
        "kind": "tmdb-embed",
        "movieUrl": "https://embed-link.example/movie/{tmdbId}?autoplay=on",
        "tvUrl": "https://embed-link.example/tv/{tmdbId}/{season}/{episode}?autoplay=on",
        "frameOrigin": "https://player-frame.example",
        "eventSource": "example_player",
        "commandSource": "example_player_command",
        "startTimeoutSeconds": 30,
        "stripElectronUserAgent": false,
        "scriptHosts": [],
        "blockedScriptPaths": ["/assets/tracker.js"],
        "blockedRequestHosts": ["analytics.example"],
        "stubGlobals": ["adlib"]
      }
    ]
  }
}
