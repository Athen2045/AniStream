# AniList OAuth is configured in the app. Store its client secret in macOS Keychain with:
# npm run configure:anilist

# Planned opt-in MangaDex account sync. Do not populate until the personal-client
# credentials have been moved to macOS Keychain.
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=
MANGADEX_USERNAME=
MANGADEX_PASSWORD=
# Public chapter-availability and future reader language (defaults to English).
MANGADEX_LANGUAGE=en

# Anikoto catalog and MegaPlay embed playback. Enabled by default.
# Set to 0 for an immediate local kill switch. Override the API URL only with
# a verified HTTPS-compatible deployment; MegaPlay's embed origin stays fixed.
ANISTREAM_ANIKOTO_ENABLED=1
ANISTREAM_ANIKOTO_API_URL=https://anikotoapi.site

# MyAnimeList public-data Client ID from https://myanimelist.net/apiconfig.
# Used for score cross-referencing and as a catalog fallback when AniList is down.
# Public reads only need this ID (X-MAL-CLIENT-ID header); no OAuth secret is stored.
ANISTREAM_MAL_CLIENT_ID=

# MangaBaka Personal Access Token (starts with "mb-") from mangabaka.org.
# Optional: the API works unauthenticated; the token raises rate limits.
ANISTREAM_MANGABAKA_TOKEN=

# Optional Parse episode-guide adapter. Keep this in .env for development or
# in ~/Library/Application Support/AniStream/.env for the packaged app.
PARSE_API_KEY=
PARSE_ANIME_SCRAPER_ID=57fd33bc-2965-4c61-9741-68e60a184d8b
PARSE_ANIME_EPISODES_ENDPOINT=get_show_episodes
