# AniList sign-in uses the app's built-in public OAuth client; no secret is needed here.

# Planned opt-in MangaDex account sync. Do not populate until the personal-client
# credentials have been moved to macOS Keychain.
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=
MANGADEX_USERNAME=
MANGADEX_PASSWORD=
# Default manga chapter language: en (default) or ja. Manga is offered in English and Japanese only.
MANGADEX_LANGUAGE=en

# Anime playback endpoints live in the gitignored providers.local.json (see
# providers.example.json). Set to 0 for an immediate local kill switch.
ANISTREAM_ANIME_SOURCE_ENABLED=1

# MyAnimeList public-data Client ID from https://myanimelist.net/apiconfig.
# Used for score cross-referencing and as a catalog fallback when AniList is down.
# Public reads only need this ID (X-MAL-CLIENT-ID header); no OAuth secret is stored.
ANISTREAM_MAL_CLIENT_ID=

# MangaBaka Personal Access Token (starts with "mb-") from mangabaka.org.
# Optional: the API works unauthenticated; the token raises rate limits.
ANISTREAM_MANGABAKA_TOKEN=

# TMDB API Read Access Token (v4 bearer) from themoviedb.org account settings.
# Required for the More section; it stays in the main process.
ANISTREAM_TMDB_ACCESS_TOKEN=
